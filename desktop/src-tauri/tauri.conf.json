{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hotel Service Admin",
  "version": "0.1.0",
  "identifier": "com.bssimple.hotelservice.admin",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Hotel Service Admin",
        "url": "https://hotel-management-rho-two.vercel.app",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
